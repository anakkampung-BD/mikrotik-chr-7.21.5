# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Telegram user IDs (comma-separated) — bisa /approve user
ADMIN_TELEGRAM_IDS=123456789

# MikroTik CHR API
MIKROTIK_HOST=host.docker.internal
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_password

# L2TP/IPsec server
L2TP_IPSEC_SECRET=your_ipsec_psk
VPN_POOL_START=10.80.0.2
VPN_POOL_END=10.80.0.254

# Public endpoint (domain atau IP VPS)
PUBLIC_HOST=your.vps.ip.or.domain

# Port allocation: pub_port = PORT_BASE + (user_slot * 10) + service_index
PORT_BASE=10000
MAX_USERS=100

# Database
DATABASE_PATH=/data/vpn-bot.db
